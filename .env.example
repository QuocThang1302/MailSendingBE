NODE_ENV=development
PORT=5000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_secret_or_anon_key
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
TRACKING_SECRET=change_me_for_public_email_tracking
EMAIL_OPEN_TRACKING_ENABLED=false
EMAIL_CLICK_TRACKING_MODE=marked
EMAIL_TRACKING_REQUIRE_HTTPS=true
EMAIL_APPEND_UNSUBSCRIBE_FOOTER=true
BCRYPT_SALT_ROUNDS=10

AI_MEDIA_PROVIDER=pollinations
POLLINATIONS_API_KEY=your_pollinations_api_key
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_IMAGE_MODEL=flux
POLLINATIONS_VIDEO_MODEL=

OPENAI_API_KEY=your_openai_api_key
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_VIDEO_MODEL=sora-2

MEDIA_STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=generated-media
SUPABASE_STORAGE_FOLDER=generated
PUBLIC_BASE_URL=http://localhost:5000
MEDIA_PUBLIC_BASE_URL=http://localhost:5000/media
